  "requirements": [
    {
      "id": "JRN-BAS-001",
      "text": "Поставка J1 добавляет к действующему приложению журнал оценок, посещаемость, темы занятий и личный просмотр студента.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-001"
      ]
    },
    {
      "id": "JRN-BAS-002",
      "text": "Существующие функции расписания и пять кодов ролей сохраняются с правами из раздела 3.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-002",
        "AC-JRN-003",
        "AC-JRN-004",
        "AC-JRN-059"
      ]
    },
    {
      "id": "JRN-BAS-003",
      "text": "Новые экраны поставляются на KK с сохранением очередности RU и EN по REQ-001, а ТЗ ведётся на русском.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-005"
      ]
    },
    {
      "id": "JRN-BAS-004",
      "text": "Новая поставка использует подготовленные аккаунты по REQ-005 без свободного выбора привилегированной роли.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-006"
      ]
    },
    {
      "id": "JRN-DAT-001",
      "text": "Администратор создаёт и исправляет карточку студента с постоянным ID, отображаемым именем, областью и признаком демоданных.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-007"
      ]
    },
    {
      "id": "JRN-DAT-002",
      "text": "Принадлежность студента группе хранится как подтверждённый интервал [дата начала, дата окончания) внутри учебного контекста.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-008"
      ]
    },
    {
      "id": "JRN-DAT-003",
      "text": "Доступ студента к журналу требует явной подтверждённой связи аккаунта с одним student_id в выбранной области.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-009"
      ]
    },
    {
      "id": "JRN-DAT-004",
      "text": "Журнал группы по предмету и семестру использует подтверждённое назначение преподавателя с интервалом действия.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-010"
      ]
    },
    {
      "id": "JRN-DAT-005",
      "text": "При первой записи занятия сервер фиксирует состав группы на дату занятия отдельным снимком состава журнала.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-011"
      ]
    },
    {
      "id": "JRN-DAT-006",
      "text": "Исправление уже зафиксированного состава администратором требует причины и сохраняет записи выбывшего студента в истории.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-012"
      ]
    },
    {
      "id": "JRN-LSN-001",
      "text": "Первая запись занятия журнала создаётся только из действующего разрешённого опубликованного события с подтверждёнными связями группы, предмета, семестра и преподавателя.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-013"
      ]
    },
    {
      "id": "JRN-LSN-002",
      "text": "Занятие журнала получает постоянный ID и снимок исходной публикации, события, даты, времени, пояса и академических связей.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-014"
      ]
    },
    {
      "id": "JRN-LSN-003",
      "text": "Первое сохранение фактических записей требует явного подтверждения преподавателем проведения занятия.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-015"
      ]
    },
    {
      "id": "JRN-LSN-004",
      "text": "Фактические записи будущего или ещё не завершившегося занятия отклоняются по времени окончания в его учебном поясе согласно предположению QJ-003.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-016"
      ]
    },
    {
      "id": "JRN-LSN-005",
      "text": "Занятие без введённой оценки или отметки посещаемости сохраняет соответствующее значение незаполненным.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-020"
      ]
    },
    {
      "id": "JRN-TOP-001",
      "text": "При первом сохранении журнал требует непустую текстовую тему после удаления крайних пробелов длиной не более 2000 символов.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-017",
        "AC-JRN-018"
      ]
    },
    {
      "id": "JRN-TOP-002",
      "text": "Исправление сохранённой темы создаёт новую ревизию с причиной по общему правилу раздела 10.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-019"
      ]
    },
    {
      "id": "JRN-ATT-001",
      "text": "Для студента на занятии сохраняется один статус из present, absent, late, excused либо незаполненное значение согласно предположению QJ-005.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-020",
        "AC-JRN-021",
        "AC-JRN-022"
      ]
    },
    {
      "id": "JRN-ATT-002",
      "text": "Запись посещаемости изменяет только выбранные строки подтверждённого состава занятия.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-023"
      ]
    },
    {
      "id": "JRN-ATT-003",
      "text": "Сервер не выводит посещаемость автоматически из оценки, входа в аккаунт или наличия занятия в расписании.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-024"
      ]
    },
    {
      "id": "JRN-ATT-004",
      "text": "Исправление или очистка сохранённой посещаемости требует причины и создаёт запись истории.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-025"
      ]
    },
    {
      "id": "JRN-GRD-001",
      "text": "Оценка принадлежит выбранному студенту и занятию и принимает значение от 0 до 100 включительно.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-026",
        "AC-JRN-027",
        "AC-JRN-028",
        "AC-JRN-029"
      ]
    },
    {
      "id": "JRN-GRD-002",
      "text": "В J1 принимаются целые баллы согласно предположению QJ-001, а дробные значения получают явный отказ проверки.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-030"
      ]
    },
    {
      "id": "JRN-GRD-003",
      "text": "Пустая оценка хранится как отсутствие значения и отображается иначе, чем оценка 0.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-031"
      ]
    },
    {
      "id": "JRN-GRD-004",
      "text": "Для пары студент и занятие существует не более одной текущей оценки согласно предположению QJ-006.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-032"
      ]
    },
    {
      "id": "JRN-GRD-005",
      "text": "Исправление или очистка сохранённой оценки требует причины и сохраняет прежнее значение в истории.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-033",
        "AC-JRN-034"
      ]
    },
    {
      "id": "JRN-GRD-006",
      "text": "Система не вычисляет итоговую оценку, средний балл, порог зачёта или перевод в пятибалльную шкалу без отдельно утверждённого правила.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-035"
      ]
    },
    {
      "id": "JRN-STU-001",
      "text": "Кабинет студента выдаёт только собственные сохранённые оценки, посещаемость, темы и даты занятий в разрешённой области.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-036"
      ]
    },
    {
      "id": "JRN-STU-002",
      "text": "Студент может выбрать учебный период и предмет и получить постраничный список собственных записей без потери применённых фильтров.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-037"
      ]
    },
    {
      "id": "JRN-STU-003",
      "text": "Просмотр записей прошлой группы использует собственный student_id и историческую принадлежность, не открывая чужие строки.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-038"
      ]
    },
    {
      "id": "JRN-STU-004",
      "text": "Кабинет содержит переход к существующему опубликованному расписанию своей разрешённой группы.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-039"
      ]
    },
    {
      "id": "JRN-UX-001",
      "text": "Интерфейс различает загрузку, отсутствие данных, незаполненную ячейку, ошибку и подтверждённое сохранение текстовыми состояниями.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-054"
      ]
    },
    {
      "id": "JRN-UX-002",
      "text": "При ошибке сети, валидации или конфликте ревизии введённые значения остаются в форме до явного решения пользователя.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-055",
        "AC-JRN-056"
      ]
    },
    {
      "id": "JRN-UX-003",
      "text": "Ячейки журнала и действия доступны с клавиатуры с видимым фокусом, подписями полей и подписанной областью прокрутки таблицы.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-057"
      ]
    },
    {
      "id": "JRN-INT-001",
      "text": "Новая публикация, изменение импорта или пересчёт расписания не изменяют и не удаляют существующие записи журнала.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-050"
      ]
    },
    {
      "id": "JRN-INT-002",
      "text": "Пара публикация и исходное событие имеет не более одной активной привязки к постоянному занятию журнала.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-014"
      ]
    },
    {
      "id": "JRN-INT-003",
      "text": "После смены публикации профиля с уже заполненным журналом запись по несопоставленному новому событию блокируется до явного решения администратора.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-051"
      ]
    },
    {
      "id": "JRN-INT-004",
      "text": "Администратор с причиной отмечает новое событие как новое занятие либо связывает его с существующей записью той же области, группы, предмета и учебного периода.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-052"
      ]
    },
    {
      "id": "JRN-INT-005",
      "text": "Сопоставление меняет только связь с планом и не переписывает исходные факты, состав, автора, время, баллы или посещаемость занятия.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-053"
      ]
    },
    {
      "id": "JRN-SEC-001",
      "text": "Сервер при каждом чтении и изменении проверяет пользователя, действие, область, data_kind и требуемую персональную или преподавательскую связь по REQ-006.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-010",
        "AC-JRN-042",
        "AC-JRN-043",
        "AC-JRN-046",
        "AC-JRN-061",
        "AC-JRN-062",
        "AC-JRN-063"
      ]
    },
    {
      "id": "JRN-SEC-002",
      "text": "Студенческий ответ не содержит чужих персональных строк, оценок, посещаемости или служебной истории даже при подмене параметров запроса.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-040",
        "AC-JRN-041"
      ]
    },
    {
      "id": "JRN-SEC-003",
      "text": "Каждая изменяющая команда журнала сохраняет существующие требования сессии, Origin и CSRF из NFR-001.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-044",
        "AC-JRN-064"
      ]
    },
    {
      "id": "JRN-SEC-004",
      "text": "Изменяющая команда передаёт ожидаемую ревизию занятия или справочника, а устаревшая команда отклоняется без перезаписи данных.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-045"
      ]
    },
    {
      "id": "JRN-SEC-005",
      "text": "Первичная запись, исправление и очистка сохраняют неизменяемую историю автора, UTC-времени, значения до и после и причины исправления.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-019",
        "AC-JRN-034"
      ]
    },
    {
      "id": "JRN-OPS-001",
      "text": "План J1 содержит семь дней реализации после отдельного разрешения пользователя и контрольную передачу по разделу 11.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-060"
      ]
    },
    {
      "id": "JRN-OPS-002",
      "text": "Сохранение темы, изменённых строк, ревизии, истории и квитанции операции выполняется одной транзакцией с полным откатом при отказе.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-047"
      ]
    },
    {
      "id": "JRN-OPS-003",
      "text": "Повтор того же operation_id тем же автором с тем же телом после проверки текущих прав возвращает прежний результат, а другое тело получает конфликт.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-048",
        "AC-JRN-049"
      ]
    },
    {
      "id": "JRN-OPS-004",
      "text": "Перед переносом схемы выполняются резервная копия и проверка восстановления расписания и журнала в отдельной тестовой БД.",
      "priority": "Must",
      "release": "J1",
      "acceptance": [
        "AC-JRN-058",
        "AC-JRN-059"
      ]
    }
